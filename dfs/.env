# Server
PORT=3000
NODE_ENV=development

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Storage
CHUNK_SIZE_MB=2
STORAGE_BASE_PATH=./storage
REPLICATION_FACTOR=3

# Node Registry (comma-separated node IDs)
# In a real system these would be remote addresses
NODE_IDS=node-a,node-b,node-c

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
